# Agent-1's database: PostGIS with agent_1_db, loaded with Agent-1's part of
# the data on the first start (init/20_agent1_data.sql, generated by
# github.com/ishancoderr/germany-demographics-births-marriages).
#
# Used by kqml-deploy (service db1) and runnable on its own (docker-compose.yml).
FROM postgis/postgis:18-3.6

# The database the init scripts load into. The image's own 10_postgis.sh runs
# first and enables PostGIS in it; then 20_agent1_data.sql creates and fills
# the tables (states, state_demographics, cities).
ENV POSTGRES_DB=agent_1_db
COPY init/ /docker-entrypoint-initdb.d/

# Ready = the real server answers over TCP (the temporary first-start server
# listens only on a socket), so "healthy" means the data is loaded.
HEALTHCHECK --interval=10s --timeout=5s --start-period=60s --retries=30 \
    CMD pg_isready -h 127.0.0.1 -U "${POSTGRES_USER:-postgres}" -d "$POSTGRES_DB" || exit 1
